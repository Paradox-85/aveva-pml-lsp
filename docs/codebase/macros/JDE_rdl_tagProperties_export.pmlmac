-- Author: Andrei Aitzhanov
-- Customer: Ramboll
-- Rev: 01
-- Purpose: export tags properties for Shell
-- $m "C:\Users\ADZV\OneDrive - Ramboll\AVEVA_SERVER\Addons\PMLLIB\RAM\Engineering\jackdow\JDE_shell_tagProperties_export.pmlmac"

--rev 2
import 'GridControl'
handle ANY
endhandle
using namespace |Aveva.Core.Presentation|
!dataList = ARRAY()
!headerList = ARRAY()
!typeList = ARRAY()
!headerList.append(|Tag Name|)
!headerList.append(|Tag Owner|)
!headerList.append(|Tag Status|)
!headerList.append(|Tag Maturity Level|)
!headerList.append(|RAM Class Name|)
!headerList.append(|SHELL Class Name|)
!headerList.append(|Property Name|)
!headerList.append(|Property Category|)
!headerList.append(|Property Type|)
!headerList.append(|Property Value|)
!headerList.append(|Property UoM|)
!headerList.append(|Property LoV|)

!idx = 0
var !tags COLL ALL (ENGITEM) WITH (:TagStatus eq |ACTIVE| and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and NOT(EMPTY(:TagStatus)) and NOT(EMPTY(:RambollTagStatus)))
do !tagString values !tags
	!idx = !idx + 1
	!tagRef = !tagString.dbref()
	!acttype = !tagRef.acttype
	skip if (!typeList.findFirst(!acttype).set())
	
	!typeList.append(!acttype)
	
	--set progress
	!tagIdx = !tags.findFirst(!tagString)
	!!displayProgress(!tagIdx, !tags.size())
	do !attString values !tagRef.attributes()
		--clean
		var !attValue DELETE
		var !value DELETE
		!isUnset = false
		
		!attValue = !tagRef.attribute(!attString)
		!value = !attValue.string()
		$( if (!attValue.unset() or !value.unset() or !value.empty() or !value eq |Unset|) then
			skip
		endif $)
		
		var !repTxt ATTDEF $!attString RPTX
		!tagDataRow = ARRAY()
		!tagDataRow.append(!tagRef.namn)
		!tagDataRow.append(!tagRef.:RAMTAGOWNER)
		!tagDataRow.append(!tagRef.:TagStatus)
		!tagDataRow.append(!tagRef.:RambollTagStatus)
		!tagDataRow.append(!tagRef.acttype)
		!tagDataRow.append(!tagRef.:TagClassName)
		!attref = object ATTRIBUTE(!attString)
		!tagDataRow.append(!repTxt.first())
		!tagDataRow.append(!attref.category().trim())
		!tagDataRow.append(!attref.type())
		
		!uom = ||
		!valueType = !attValue.objecttype()
		if (!valueType eq 'REAL' and !isUnset.not()) then
			!value = !attValue.value().string()
			!uom = !attValue.unit().string()
		endif
		if (!valueType eq 'DBREF' and !isUnset.not()) then
			!value = !attValue.namn
			handle any
			endhandle
		endif
		if (!valueType eq 'ARRAY' and !isUnset.not()) then
			!value = |List of items|
		endif
		--lov
		!lovString = ||
		!lovList = !attref.VALIDVALUES(!tagRef)
		do !lovItem values !lovList
			!lovString = !lovString + | | + !lovItem
			handle (2,442)
				break
			endhandle
		enddo
		!lovString = !lovString.trim()
		
		!tagDataRow.append(!value)
		!tagDataRow.append(!uom)
		!tagDataRow.append(!lovString)
		
		!dataList.append(!tagDataRow)
	enddo
enddo

!publishPath = |C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\RDL\AA_analysis\4_class-attribute overview\aveva-tag-properties-list_240124.xlsx|
!dataTable = object NETGRIDCONTROL()
!dataTable.clearGrid()
!source = object NETDATASOURCE('data', !headerList, !dataList)
!dataTable.BindToDataSource(!source)
!dataTable.saveGridToExcel(|$!publishPath|, |data|)	