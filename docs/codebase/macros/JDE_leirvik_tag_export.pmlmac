-- Rev: 01
-- Purpose: auto-extract delta data for EBE project
-- $m \\ramcphe3d01\Projects\rde\pmllib\engineering\JDE_leirvik_tag_export.pmlmac
-- $m "C:\Users\ADZV\OneDrive - Ramboll\AVEVA_SERVER\Addons\PMLLIB\RAM\Engineering\jackdow\JDE_leirvik_tag_export.pmlmac"

TAGS

!startDateTime = OBJECT DATETIME()
!year = !startDateTime.year()
!month = !startDateTime.month().string('I2')
!date = !startDateTime.date().string('I2')
!hour = !startDateTime.hour().string('I2')
!minute = !startDateTime.minute().string('I2')

import |Aveva.Engineering.Tags.Pml|
handle any
endhandle
using namespace |Aveva.Engineering.Tags|
!!tags = object PMLTAGS()

import 'GridControl'
handle ANY
endhandle
using namespace |Aveva.Core.Presentation|

--get list of stamps
var !grids collect all LSTDEF with (Desc eq 'Leirvik export')
if (!grids.size() gt 0) then
	do !exportGrid values !grids
		!gridName = !exportGrid.dbref().lstnam
		!gridDef = !!tags.GetListDefinition('15.2 Leirvik Data Export', !gridName)
		!sourceDbView = !gridDef.DbViewName()

		!publishFolderPath = |C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\Aveva\_LEI data\To LEI\_autoExport\|
		!publishPath = '$!<publishFolderPath>$!year-$!month-$!date_$!hour-$!minute\'
		Syscom |MKDIR "$!publishPath"|
		!dataFileName = |$!<gridName>.xlsx|
		
		using namespace |Aveva.Core.Presentation|
		!!tags.exportasxls('15.2 Leirvik Data Export','$!gridName','$!publishPath$!dataFileName')
	enddo
endif

FINISH
