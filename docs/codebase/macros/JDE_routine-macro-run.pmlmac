TAGS

ONERROR GOLABEL /Error

--define common vars
!!ramCommonLogger = object RAMCOMMONLOGGER()
!headings = |Tag Name;Attribute Name;Error Text|
!!ramCommonLogger.addHeading(!headings.split(|;|))
!rdlMasterFile = |C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\RDL\_Master\RDL-Master-File.xlsx|


$P --- START ROUTINE PROCESSING ---
$P --- STEP 1: DELETE UNTAGGED ITEMS  ---
!tagMgmt = object TAGMANAGEMENTTMP()
!tagMgmt.deleteUnnamedTags()

$P --- STEP 2: PROPOGATE PARENT DATA TO CHILDS (FOR PACKAGES)  ---
--!!jacPropagateParentData(|:TagRefToParentTag|, !attString.split(), |ISNAMED and :TagStatus eq 'ACTIVE'|, false)

$P --- STEP 3: UPDATE CLASS NAME AS PER SHELL RDL MAPPING  ---
!!jacUpdateClassDetails(!rdlMasterFile, |Class-mapping|, |NA|, |(unset(:TagRefToClass) or badref(:TagRefToClass) or ACTTYPE neq (:RDLDabaconExpression of :TagRefToClass) or unset(:TagRefToClass) or unset(:TagClassName)) and :TagStatus inset ('ACTIVE', 'ASB', 'AFC', 'AFD', 'Future') and ISNAMED|, |:RDLSource of :ClassMappingRefToClass eq 'AKSO_Tag Properties Templates_Rev6'|, true)

$P --- STEP 4: UPDATE EQUIPMENT NAMES --- *** NOT IN USE
--!!jacUpdateEquipmentNumber(|:RAMEquipmentNumber|, |Equip_$| + |!<elementRefe.NAMN>|, false)

$P --- STEP 5: UPDATE TAG NAME ---
--all
!replaceArray = array()
!!jacUpdateTagName(|NAMN|, |:TagName|, !replaceArray, |ISNAMED and (:TagName neq NAMN) and not(LOWCASE(:TagClassName) inset ('pipeline', 'pipe'))|, true)

--pipes with inches
!replace[1] = |_|
!replace[2] = | |
!replaceArray.append(!replace)
!!jacUpdateTagName(|NAMN|, |:TagName|, !replaceArray, |ISNAMED and (matchwild(name, '*"-*')) and (:TagName neq NAMN) and (LOWCASE(:TagClassName) inset ('pipeline', 'pipe'))|, true)
!!jacUpdateTagNameWithBore(!rdlMasterFile, |DN_mapping|, |NAMN|, |:TagName|, | |, |ISNAMED and not(unset(:TagStatus)) and not(matchwild(name, '*"-*')) and :TagClassName inset('pipeline', 'pipe')|, true)

$P --- STEP 6: REMOVE DUBLICATED LINKS IN TAG-DOCs ---
!!jacRemoveDocumentDuplicate()

$P --- STEP 7: CHECK ALL TAGS ---
--!!jacNameRegExValidatorTTY(false, true)

--DEFINE PLANT CODE based on pattern info
--!!jacUpdatePatternToAttribute(!patternRef, |:PlantCode|, 1, |ISNAMED and :TagStatus eq 'ACTIVE'|, true)

$P --- STEP 8: 3D PIPE DATA TRANSFER  ---
!tagMgmt.pipeDataTransfer()

$P --- STEP 9: VALVE UPDATE  ---
!tagMgmt.valveDataUpdate()

$P --- STEP 10: ALARM LIST UPDATE  ---
!tagMgmt.alarmsDataUpdate()

$P --- STEP 11: SIGNAL LIST UPDATE  ---
!tagMgmt.signalsDataUpdate()

$P --- STEP 12: LOOP LIST UPDATE  ---
!tagMgmt.loopsDataUpdate()

$P --- STEP 13: CABLE LIST UPDATE  ---
!tagMgmt.cablesDataUpdate()

$P --- STEP 14: TAG-DOC DATA UPDATE  ---
!tagMgmt.tagDocLinksUpdate()

$P --- STEP 10: FINISH TASKS  ---
!dt = OBJECT DATETIME()
!year = !dt.year()
!month = !dt.month().string('I2')
!date = !dt.date().string('I2')
!hour = !dt.hour().string('I2')
!minute = !dt.minute().string('I2')
!!ramCommonLogger.writeErrorDataToExcel(|C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\Aveva\Logs\Night-macro\common-log_$!<year>-$!<month>-$!<date>-$!<hour>.xlsx|, false)

LABEL /Error
handle any
	SAVEWORK
	UNCLAIM ALL
	!dt = OBJECT DATETIME()
	!year = !dt.year()
	!month = !dt.month().string('I2')
	!date = !dt.date().string('I2')
	!hour = !dt.hour().string('I2')
	!minute = !dt.minute().string('I2')
	!!ramCommonLogger.writeErrorDataToExcel(|C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\Aveva\Logs\Night-macro\common-log_$!<year>-$!<month>-$!<date>-$!<hour>.xlsx|, false)
	--FINISH
endhandle

FINISH