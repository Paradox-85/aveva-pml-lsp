-- Author: Andrei Aitzhanov
-- Customer: Ramboll
-- Rev: 01
-- Purpose: auto-extract 3D data from 3D model
-- $m "C:\Users\ADZV\OneDrive - Ramboll\AVEVA_SERVER\Addons\PMLLIB\RAM\Engineering\ew1\EBA_full_tag_export.pmlmac"

DESIGN

import 'GridControl'
handle ANY
endhandle

!startDateTime = OBJECT DATETIME()
!year = !startDateTime.year()
!month = !startDateTime.month().string('I2')
!date = !startDateTime.date().string('I2')
!hour = !startDateTime.hour().string('I2')
!minute = !startDateTime.minute().string('I2')

!msg = |Tag Name;Type;Description;Site Name;Zone Name|
!headerList = ARRAY()
!dataList = ARRAY()
!headerList.appendArray(!msg.split(|;|))

var !items collect all (EQUI SUBE STRUC FRMW SBFR PIPE HVAC CWAY SUPPO BRAN MEM) with (ISNAMED)
do !item values !items
	!itemRef = !item.dbref()
	var !site namn of site of $!item
	handle any
		skip
	endhandle
	var !zone namn of zone of $!item
	handle any
		skip
	endhandle
	var !desc desc of $!item
	handle any
		var !desc dtxr of $!item
	endhandle
	!msg = |$!<itemRef.namn>;$!<itemRef.acttype>;$!<desc>;$!site;$!zone|
	!dataList.append(!msg.split(|;|))
enddo

using namespace |Aveva.Core.Presentation|
!publishPath = 'C:\Users\ADZV\OneDrive - Ramboll\Digital Deliveries\LCI\04_3D-tags\_export\'
!dataFileNameDated 	= |RAM_3DtagRegister_$!<year>-$!<month>-$!<date>_$!<hour>-$!<minute>.xlsx|
!dataFileName 		= |RAM_3DtagRegister.xlsx|
!dataTable 			= object NETGRIDCONTROL()
!dataTable.clearGrid()
!source = object NETDATASOURCE('data', !headerList, !dataList)
!dataTable.BindToDataSource(!source)
!dataTable.saveGridToExcel(|$!<publishPath>$!<dataFileNameDated>|)
!dataTable.saveGridToExcel(|$!<publishPath>$!<dataFileName>|)

FINISH
