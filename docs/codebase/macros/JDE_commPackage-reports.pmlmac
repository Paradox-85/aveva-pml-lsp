-- Run path: $m "C:\Users\ADZV\OneDrive - Ramboll\AVEVA_SERVER\Addons\PMLLIB\RAM\Engineering\jackdow\_publish\macro\JDE_commPackage-reports.pmlmac"
-- Run comm package data to excel
--Author: Andrei Aitzhanov
-- Company Ramboll Energies
