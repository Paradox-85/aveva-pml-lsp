-- Run path: $m "C:\Users\ADZV\OneDrive - Ramboll\AVEVA_SERVER\Addons\PMLLIB\RAM\Engineering\jackdow\JDE_tagProperties_upload.pmlmac"
-- Mass upload data from excel spreedsheet
--Author: Andrei Aitzhanov
-- Company Ramboll Energies
-- Date:
import 'GridControl'
handle ANY
endhandle
using namespace |Aveva.Core.Presentation|
!dataTable = object NETGRIDCONTROL()

!PathName = 'C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\Aveva\Leirvik data\To upload\25-09-23\TagsWithInstallationContractor 25.09.23.xlsx'
!file = object File(!PathName)
!fileName = !file.name()
!issueData = ARRAY()
!dataSource = object NETDATASOURCE('Grid Table', !fileName)
!dataTable.bindToDataSource(!dataSource)
!data = !dataTable.getrows()
do !row values !data
	!Tag = !row[1]
	!EngCon = !row[2]
	!InsCon = !row[3]
	
	-- tag checking
	!isTagValid = true
	!tagName = |/$!<Tag>|
	!tagref = !tagName.dbref()
	handle any
		!issueMsg = |$!<Tag>;TAG $!<Tag> is not exis in AVEVA|
		!issueData.append(!issueMsg)
		!isTagValid = false
	endhandle
	
	if (!isTagValid) then
		
		!ciValue = !tagref.:RAMInstallationContractors
		handle any
			!issueMsg = |$!<Tag>;$!!error.text|
			!issueData.append(!issueMsg)
		elsehandle none
			if (!ciValue.lowcase().trim() neq !InsCon.lowcase().trim()) then 
				!tagref.:RAMInstallationContractors = !InsCon
			else
				!issueMsg = |$!<Tag>;No changes for :RAMInstallationContractors: uploading value <$!InsCon> = current value <$!ciValue>|
				!issueData.append(!issueMsg)
			endif
		endhandle
		
		
		!ceValue = !tagref.:RAMTAGOWNER
		handle any
			!issueMsg = |$!<Tag>;$!!error.text|
			!issueData.append(!issueMsg)
		elsehandle none
			if (!ceValue.lowcase().trim() neq !EngCon.lowcase().trim()) then 
				!tagref.:RAMTAGOWNER = !EngCon
				handle any
					!issueMsg = |$!<Tag>;$!!error.text|
					!issueData.append(!issueMsg)
				endhandle
			else
				!issueMsg = |$!<Tag>;No changes for :RAMTAGOWNER: uploading value <$!EngCon> = current value <$!ceValue>|
				!issueData.append(!issueMsg)
			endif
		endhandle
	endif
enddo

!dataFile = object file('C:\Users\ADZV\OneDrive - Ramboll\Ramboll_Jackdaw - Admin Team\Aveva\Leirvik data\To upload\25-09-23\TagsWithInstallationContractor 25.09.23_issues.csv')
!dataFile.writeFile(|OVERWRITE|, !issueData) 

--SAVEWORK
--FINISH