$(--export MTR data
!!tags = object PMLTAGS()
var !grid collect all LSTDEF with (LSTNAM eq |IM-tag-dataset|)
if (!grid.size() eq 1) then
	!gridRef = !grid.first().dbref()
	!gridRef.lstflt = !realUnset
	!filePathOrigin = |$!pathName\_master\data\MTR-dataset.xlsx|
	!filePath = |$!pathName\_master\data\_history\MTR-dataset-$!<year>-$!<month>-$!<date>_$!<hour>.xlsx|
	var !gridGroupName CATNAM of LSTGRP of $!gridRef
	!!tags.exportasxls(!gridGroupName, '$!<gridRef.LSTNAM>', '$!filepath')
	SYSCOM |copy /y "$!<filePath>" "$!<filePathOrigin>"|
endif$)

$(--export DOC data
!realUnset = ARRAY()
!!tags = object PMLTAGS()
var !grid collect all LSTDEF with (LSTNAM eq |403-DOCUMENT|)
if (!grid.size() eq 1) then
	!gridRef = !grid.first().dbref()
	!gridRef.lstflt = !realUnset
	!filePathOrigin = |$!pathName\_master\data\MDR.xlsx|
	!filePath = |$!pathName\_master\data\_history\MDR-$!<year>-$!<month>-$!<date>_$!<hour>.xlsx|
	var !gridGroupName CATNAM of LSTGRP of $!gridRef
	!!tags.exportasxls(!gridGroupName, '$!<gridRef.LSTNAM>', '$!filepath')
	SYSCOM |copy /y "$!<filePath>" "$!<filePathOrigin>"|
endif$)

$(--collect data based on type
!classList = ARRAY()
!classList.append(|SIGNAL CABLE|)
do !className values !classList
                !tagFilter = 'NOT(:TagStatus inset (|VOID|, |Future|)) and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and :RDLName of :ClassMappingRefToClass of :TagRefToClass eq |$!className|'
	var !tagList collect all (ENGITE) with ($!tagFilter)
	!size = !tagList.size()
	if (!size gt 0) then
		!rdlFilter = |:RDLSource eq 'AKSO_Tag Properties Templates_Rev6'|
		!filePathRam = |$!pathName\_master\data\vendor_data\vendorReport-$!<className>.xlsx|
		!!jacExportRDLDataReportMatrix(!filePathRam, !rdlFilter, !tagFilter, !emptyPatternList, !commonAttribiutes, !replaceData, !isErrorReport)
	endif
enddo$)

--collect data based on tag name
$(!pattern = |*GB.*|
!tagFilter = 'NOT(:TagStatus inset (|VOID|, |Future|)) and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and matchwild(name, |$!pattern|)'
var !tagList collect all (ENGITE) with ($!tagFilter)
!size = !tagList.size()
if (!size gt 0) then
	!rdlFilter = |:RDLSource eq 'AKSO_Tag Properties Templates_Rev6'|
	!filePathRam = |$!pathName\_master\data\vendor_data\vendorReport-SWA.xlsx|
	!!jacExportRDLDataReportMatrix(!filePathRam, !rdlFilter, !tagFilter, !emptyPatternList, !commonAttribiutes, !replaceData, !isErrorReport)
endif$)

--collect vendor packages
$(!packageListString = |CPI|
!packageList = !packageListString.split()
do !pckgName values !packageList
	$P Package name: $!pckgName
	--!tagFilter = 'NOT(:TagStatus inset (|VOID|, |Future|)) and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and (:RAMPackageNumber of :TagRefToPurchaseOrder eq |$!pckgName|)'
                !tagFilter = 'NOT(:TagStatus inset (|VOID|, |Future|)) and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and matchwild(namn of :TagRefToPurchaseOrder, |*$!pckgName*|)'
	var !tagList collect all (ENGITE) with ($!tagFilter)
	!size = !tagList.size()
	if (!size gt 0) then
		!rdlFilter = |:RDLSource eq 'AKSO_Tag Properties Templates_Rev6'|
		!filePathRam = |$!pathName\_master\data\vendor_data\vendorReport-$!<pckgName>.xlsx|
		!!jacExportRDLDataReportMatrix(!filePathRam, !rdlFilter, !tagFilter, !emptyPatternList, !commonAttribiutes, !replaceData, !isErrorReport)
	endif
enddo$)

--colleact comm packages
$(!packageListString = |8402-C24|
!packageList = !packageListString.split()
do !pckgName values !packageList
	!tagFilter = 'NOT(:TagStatus inset (|VOID|, |Future|)) and ISNAMED and NOT(EMPTY(:RAMTAGOWNER)) and matchwild(NAMN of :MCPackageToCommissioningPackageRef of :TagRefToMCPackage, |*$!pckgName*|)'
	var !tagList collect all (ENGITE) with ($!tagFilter)
	!size = !tagList.size()
	if (!size gt 0) then
		!rdlFilter = |:RDLSource eq 'AKSO_Tag Properties Templates_Rev6'|
		!filePathRam = |$!pathName\_master\data\comm_data\commReport-$!<pckgName>.xlsx|
		!!jacExportRDLDataReportMatrix(!filePathRam, !rdlFilter, !tagFilter, !emptyPatternList, !commonAttribiutes, !replaceData, !isErrorReport)
	endif
enddo$)