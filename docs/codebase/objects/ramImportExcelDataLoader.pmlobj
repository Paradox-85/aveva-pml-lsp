----------------------------------------------------------------------
--
-- Method:      .getUOMName
--
-- Description: Get uom value from excel uom
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Excel uom name
-- Return:
--   [Data Type] [Description]
--    DBREF        AVEVA uom name
------------------------------------------------------------------------
define method .getUOMName(!uomExcelName is STRING) is STRING
  
  !defaultValue    = object STRING()
  !value           = !this.configDetail.getUOMName(!uomExcelName)
  !isValueSet      = !value.set() AND !value.trim().neq('')
  if(!isValueSet) then
    !defaultValue  = !value
  endif
  
  return !defaultValue
  
endmethod

----------------------------------------------------------------------
--
-- Method:      .getSettingValue
--
-- Description: Get value based on paramter if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element Name
-- Return:
--   [Data Type] [Description]
--    DBREF        Element
------------------------------------------------------------------------
define method .getSettingValue(!settingKey is STRING) is STRING
  
  !defaultValue    = object STRING()
  !value           = !this.configDetail.getSettingDetail(!settingKey)
  !isValueSet      = !value.set() AND !value.trim().neq('')
  if(!isValueSet) then
    !defaultValue  = !value
  endif
  
  return !defaultValue
  
endmethod

----------------------------------------------------------------------
--
-- Method:      .getProcessedValue
--
-- Description: Get value based on paramter if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element Name
-- Return:
--   [Data Type] [Description]
--    DBREF        Element
------------------------------------------------------------------------
define method .getProcessedValue(!value is STRING, !parameter is STRING) is STRING

  return !this.getProcessedValue(!value, !parameter, false)
  
endmethod

----------------------------------------------------------------------
--
-- Method:      .getProcessedValue
--
-- Description: Get value based on paramter if any
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element Name
-- Return:
--   [Data Type] [Description]
--    DBREF        Element
------------------------------------------------------------------------
define method .getProcessedValue(!value is STRING, !parameter is STRING, !isSpecialCharRemove is BOOLEAN) is STRING
  
  !result          = !value
  if(!parameter.set() AND !parameter.trim().neq('')) then
    !isFunction    = !parameter.occurs('#PML').gt(0)
    !isText        = !parameter.occurs('#TEXT').gt(0)
    !isPrefix      = !parameter.occurs('#PREFIX').gt(0)
    !isSuffix      = !parameter.occurs('#SUFFIX').gt(0)
    if(!isFunction) then
      !function    = !parameter.after('#PML(').substring(-2)
      !result      = $!function
      
    elseif(!isText) then
      !result      = !parameter.after('#TEXT(').substring(-2)
      
    elseif(!isPrefix) then
      !result      = !parameter.after('#PREFIX(').substring(-2) + !result
      if(!isSpecialCharRemove) then
        !result    = !result.replace(' ', '').replace('_', '').replace('-', '')
      endif
      
    elseif(!isSuffix) then
      !result      = !result + !parameter.after('#SUFFIX(').substring(-2)
      if(!isSpecialCharRemove) then
        !result    = !result.replace(' ', '').replace('_', '').replace('-', '')
      endif
    endif
  endif
  
  return !result
  
endmethod

----------------------------------------------------------------------
--
-- Method:      .processClassStorageAttribute
--
-- Description: get the attribute which stores the class information, if set in config file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element Name
-- Return:
--   [Data Type] [Description]
--    DBREF        Element
------------------------------------------------------------------------
define method .processClassStorageAttribute() is ARRAY
  
  !attributeData           = object ARRAY()
  
  !classAttributeData      = !this.getSettingValue('ClassStorageAttribute')
  if(!classAttributeData.set()) then
    !attName               = !classAttributeData.before('[').trim()
    !attParam              = !classAttributeData.after('[').before(']').trim()
    !attributeName         = !this.validateAttribute(!attName)
    if(!attributeName.set()) then
      !attributeData.append(!attName)
      !attributeData.append(!attParam)
    endif
  endif
  
  return !attributeData
  
endmethod

------------------------------------------------------------------------
--
-- Method:     addErrorToList
-- Description: Method to add errors to common logger
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--     1    R          DBREF          Element
--     2    R          STRING       Attribute Name
--     3    R          STRING       Error Details
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .addErrorToList(!element is STRING, !detail is STRING, !error is STRING)

  if(undefined(!!ramCommonLogger)) then
    !!ramCommonLogger = object RAMCOMMONLOGGER()
  endif

  !errorList          = object ARRAY()
  !errorList.append(!element)
  !errorList.append(!detail)
  !errorList.append(!error)
  !!ramCommonLogger.addLogDetails(!this.objecttype(), !errorList)
  
endmethod

