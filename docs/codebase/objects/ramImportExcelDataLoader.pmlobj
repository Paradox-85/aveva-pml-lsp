------------------------------------------------------------------------
define method .setConfigDetail(!config is RAMIMPORTEXCELCONFIGLOADER)
  
  !this.configDetail = !config
  
endmethod

----------------------------------------------------------------------
-- Method:     initiateMappings
--
-- Description: initiate mappings process based on priority
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .initiateMappings()
  
  !this.classMapping()
  !this.attributeMapping()
  !this.uomMapping()
  
endmethod

----------------------------------------------------------------------
-- Method:     validateElementType
--
-- Description: Return name if valid, otherwise unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .validateElementType(!name is STRING) is STRING

  !className           = object STRING()
  !elementType         = object ELEMENTTYPE(!name)
  !isExists            = !elementType.name().neq('UNKNOWN')
  if(!isExists) then
    !className         = !elementType.name().upcase()
  endif
  
  return !className
  
endmethod

----------------------------------------------------------------------
-- Method:     getClassDetails
--
-- Description: Get class name from excel classification name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getClassName(!excelClassName is STRING) is STRING

  !classPriorities     = !this.configDetail.getPriorityOrder('Class processing')
  !className           = object STRING()
  
  !priorityOrders      = !classPriorities[1]
  !parameterOrders     = !classPriorities[2]

  do !i indices !priorityOrders
  
    !classPriority     = !priorityOrders[!i]
    !parameter         = !parameterOrders[!i]
    if(!className.unset()) then
      !isDelegate      = !classPriority.eq('Calculation')
      !isMapping       = !classPriority.eq('Mapping')
      !isAutoMap       = !classPriority.eq('Auto-definition')

      if(!isMapping) then
        !className     = !this.configDetail.getClassName(!excelClassName, 'attribute')
        
      elseif(!isAutoMap) then
        !className     = !this.getClassWithAutoMapping(!excelClassName)
        
      elseif(!isDelegate) then
        !className     = !this.getProcessedValue(!excelClassName, !parameter, true)
        handle any
        endhandle
      endif
      
      if(!className.set()) then
        !className     = !this.validateElementType(!className)
      endif
    endif
  enddo
  
  return !className
  
endmethod

----------------------------------------------------------------------
-- Method:     classMapping
--
-- Description: Map the class in master list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .classMapping()
  
  !this.classMapping   = object ARRAY()
  
  do !listData values !this.masterList
    !className         = object STRING()
    !excelClassName    = !listData[1]
    !className         = !this.getClassName(!excelClassName)
    !this.classMapping.append(!className)
    if(!className.unset()) then
      !this.addErrorToList(!excelClassName, 'Class Mapping', 'Not able to derive class name based on configuration')
    endif
  enddo
  
endmethod

----------------------------------------------------------------------
-- Method:     getClassWithAutoMapping
--
-- Description: Get the possible class match
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getClassWithAutoMapping(!excelClassName is STRING) is STRING
  
  !className           = object STRING()
  !tempName            = !excelClassName.replace(' ', '')
  if(!tempName.matchwild(':*').not()) then
    !tempName          = ':' + !tempName
  endif
  
  !elementType         = object ELEMENTTYPE(!tempName)
  !isExists            = !elementType.name().neq('UNKNOWN')
  if(!isExists) then
    !className         = !elementType.name()
  else
    if(!tempName.occurs('_').gt(0) or !tempName.occurs('-').gt(0)) then
      !tempName        = !tempName.replace('_', '').replace('-', '')
      !className       = !this.getClassWithAutoMapping(!tempName)
    endif
  endif
  
  return !className
  
endmethod

----------------------------------------------------------------------
-- Method:     validateAttribute
--
-- Description: Return name if valid, otherwise unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .validateAttribute(!attName is STRING) is STRING

  !attributeName           = object STRING()
  !tempName                = !attName.replace(' ', '')
  !attribute               = object ATTRIBUTE(!tempName)
  !isExists                = !attribute.name().neq('')
  if(!isExists) then
    !attributeName         = !attribute.querytext().upcase()
  endif
  
  return !attributeName
  
endmethod

----------------------------------------------------------------------
-- Method:     validateAttribute
--
-- Description: Return name if valid, otherwise unset
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .validateAttribute(!elementRefe is DBREF, !attName is STRING) is STRING

  !attributeName           = object STRING()
  !attribute               = object ATTRIBUTE(!name)
  !isExists                = !attribute.name().neq('')
  if(!isExists) then
    !attributeName         = !attribute.name().upcase()
  endif
  
  return !attributeName
  
endmethod

----------------------------------------------------------------------
-- Method:     attributeMapping
--
-- Description: Map the attribute in master list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .attributeMapping()
  
  !this.attributeMapping      = object ARRAY()
  !this.attributeParameter    = object ARRAY()
  !this.uomMapping            = object ARRAY()
  
  do !listData values !this.masterList
    !attPriorities            = !this.configDetail.getPriorityOrder('Attribute processing')
    !priorityOrders           = !attPriorities[1]
    !parameterOrders          = !attPriorities[2]
    !excelClassName           = !listData[1]
    !excelHeadings            = !listData[2]
    !attributeList            = object ARRAY()
    !parameterList            = object ARRAY()
    !uomList                  = object ARRAY()
    
    do !excelHeading values !excelHeadings
      !attributeName          = object STRING()
      !parameter              = object STRING()
      !excelAttName           = !excelHeading.before('[').trim()
      !uomName                = !excelHeading.after('[').before(']').trim()
      
      do !i indices !priorityOrders
        !attPriority          = !priorityOrders[!i]
        !calculateParameter   = !parameterOrders[!i]
      
        if(!attributeName.unset()) then
          !isDelegate         = !attPriority.eq('Calculation')
          !isMapping          = !attPriority.eq('Mapping')
          !isAutoMap          = !attPriority.eq('Auto-definition')
          
          if(!isMapping) then
            !parameter        = !this.configDetail.getAttributeName(!excelAttName, 'parameter')
            !attributeName    = !this.configDetail.getAttributeName(!excelAttName, 'attribute')
            
          elseif(!isAutoMap) then
            !attributeName    = !this.getAttributeWithAutoMapping(!excelAttName)
            
          elseif(!isDelegate) then
            !attributeName    = !this.getProcessedValue(!excelAttName, !calculateParameter, true)
            handle any
            endhandle
          endif
          
          if(!attributeName.set()) then
            !attributeName    = !this.validateAttribute(!attributeName)
          endif
        endif
      enddo

      if(!attributeName.unset()) then
        !this.addErrorToList(!excelAttName, 'Attribute Mapping', 'Not able to derive attribute for class - ' + !excelClassName)
      endif
      
      !attributeList.append(!attributeName)
      !parameterList.append(!parameter)
      !uomList.append(!uomName)
    enddo
    !this.attributeMapping.append(!attributeList)
    !this.attributeParameter.append(!parameterList)
    !this.uomMapping.append(!uomList)
  enddo
  
endmethod

----------------------------------------------------------------------
-- Method:     getAttributeWithAutoMapping
--
-- Description: Get the possible attribute match
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .getAttributeWithAutoMapping(!excelAttributeName is STRING) is STRING
  
  !attributeName           = object STRING()
  !tempName                = !excelAttributeName.replace(' ', '')
  !attributeName           = !this.validateAttribute(!tempName)
  if(!attributeName.unset()) then
    if(!tempName.matchwild(':*').not()) then
      !tempName            = ':' + !tempName
      !attributeName       = !this.validateAttribute(!tempName)
    endif
    if(!attributeName.unset()) then
      if(!tempName.occurs('_').gt(0) or !tempName.occurs('-').gt(0) or !tempName.occurs('(').gt(0) or !tempName.occurs(')').gt(0)) then
        !tempName          = !tempName.replace('_', '').replace('-', '').replace('(', '').replace(')', '')
        !attributeName     = !this.validateAttribute(!tempName)
      endif
    endif
  endif
  
  return !attributeName
  
endmethod

