import 'RamAEPMLExcelReader'
handle any
endhandle

using namespace 'RamAEPMLExcelReader'

define object RAMIMPORTEXCELDATALOADER
  
  -- 1 = sheet Name = class Name
  -- 2 = column Name = attribute Name
  -- 3 = Import Data = attribute Value
  member .masterList            is ARRAY
  
  member .classMapping          is ARRAY

  
  member .attributeMapping      is ARRAY
  member .attributeParameter    is ARRAY
  member .uomMapping            is ARRAY
  
  member .configDetail          is RAMIMPORTEXCELCONFIGLOADER
  member .sheetCount            is REAL

  -- using namespace 'RamAEPMLExcelReader'
  -- member .excelReader           is PMLEXCELHELPER
  
endobject

------------------------------------------------------------------------
--
-- Method:     ramImportExcelDataLoader
-- Description: constructor method
--
------------------------------------------------------------------------
define method .ramImportExcelDataLoader()
  !this.clearMappings()
endmethod

----------------------------------------------------------------------
-- Method:     loadExcelData
--
-- Description: Load the excel data in array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .clearMappings()
  !this.masterList           = object ARRAY()
  !this.classMapping         = object ARRAY()
  -- using namespace 'RamAEPMLExcelReader'
  -- !this.excelReader          = object PMLExcelHelper()

  !this.attributeMapping     = object ARRAY()
  !this.attributeParameter   = object ARRAY()
  !this.uomMapping           = object ARRAY()
  !this.sheetCount           = 0
endmethod

----------------------------------------------------------------------
-- Method:     loadExcelData
--
-- Description: Load the excel data in array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .loadExcelData(!excelFilePaths is ARRAY, !isTransposeList is ARRAY)
  
  do !i indices !excelFilePaths
    !this.loadExcelData(!excelFilePaths[!i], !isTransposeList[!i].boolean())
  enddo
endmethod

----------------------------------------------------------------------
-- Method:     loadExcelData
--
-- Description: Load the excel data in array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .loadExcelData(!excelFilePath is STRING, !isTransposeExcel is BOOLEAN)
  
  using namespace 'RamAEPMLExcelReader'
  !excelReader                = object PMLExcelHelper()
  clock init
  !excelReader.ReadExcel(!excelFilePath)
  !sheetNames                 = !excelReader.GetSheetNamesFromLoadedExcel()
  clock read all
  !masterColumnName           = !this.getSettingValue('MasterClassColumn')
  do !index indices !sheetNames
    !isMasterTable            = false
    !excelSheetName           = !sheetNames[!index].upcase()
    
    !sheetSize                = !excelReader.getSheetSize(!excelSheetName)
    if(!sheetSize.gt(1)) then
      !excelHeading           = !excelReader.getSheetHeadings(!excelSheetName)
      !headings               = !excelHeading.evaluate(object BLOCK(|!excelHeading[!evalIndex].upcase()|))
      if(!masterColumnName.set()) then
        !masterColumnIndex    = !headings.findFirst(!masterColumnName.upcase())
        !isMasterTable        = !masterColumnIndex.set()
      endif
      
      !tableExtract           = object ARRAY()
      if(!isTransposeExcel) then
        !dataTables           = object ARRAY()
        !nameColumn           = !this.getSettingValue('NameColumn')
        !headingColumnName    = !this.getSettingValue('MasterAttributeColumn')
        !valueColumnName      = !this.getSettingValue('MasterAttributeValueColumn')
        !uomColumnName        = !this.getSettingValue('MasterUOMColumn')
        !nameColumnIndex      = !headings.findFirst(!nameColumn.upcase())
        !headingColumnIndex   = !headings.findFirst(!headingColumnName.upcase())
        !valueColumnIndex     = !headings.findFirst(!valueColumnName.upcase())
        !uomColumnIndex       = !headings.findFirst(!uomColumnName.upcase())
        if(!nameColumnIndex.set() AND !headingColumnIndex.set() AND !valueColumnIndex.set() AND !uomColumnIndex.set()) then

          -- For creation, update and reclassify option
          if(!isMasterTable) then
            !classNames       = !excelReader.getSheetColumn(!excelSheetName, !masterColumnIndex)
            !classNames.unique()
            do !className values !classNames
              !tempNames      = !excelReader.getSheetColumn(!excelSheetName, !nameColumnIndex, !masterColumnIndex, !className)
              !tempNames.unique()
              !tempDataTables = !this.extractTablesFromTransposeFormat(!excelReader, !tempNames, !className, !excelSheetName, !nameColumn, $
                                                                       !nameColumnIndex, !headingColumnIndex, !valueColumnIndex, !uomColumnIndex)
              !dataTables.AppendArray(!tempDataTables)
            enddo

          -- Only for update attribute option
          else
            !tempNames        = !excelReader.getSheetColumn(!excelSheetName, !nameColumnIndex)
            !tempNames.unique()
            !tempDataTables   = !this.extractTablesFromTransposeFormat(!excelReader, !tempNames, !excelSheetName, !excelSheetName, !nameColumn, $
                                                                       !nameColumnIndex, !headingColumnIndex, !valueColumnIndex, !uomColumnIndex)
            !dataTables.AppendArray(!tempDataTables)
          endif
        endif
        !tableExtract         = !dataTables

      elseif(!isMasterTable) then
        !dataTables           = object ARRAY()
        !classNames           = !excelReader.getSheetColumn(!excelSheetName, !masterColumnIndex)
        !classNames.unique()
        do !className values !classNames
          !tempTable          = !excelReader.getSheetRows(!excelSheetName, !masterColumnIndex, !className)
          !data               = !this.createDataTable(!className, !headings, !tempTable, !excelSheetName)
          !dataTables.append(!data)
        enddo
        !tableExtract         = !dataTables


      else
        !rowDetails           = !excelReader.getSheetRows(!excelSheetName)
        !data                 = !this.createDataTable(!excelSheetName, !headings, !rowDetails, !excelSheetName)
        !tableExtract.append(!data)
      endif
      !this.masterList.appendArray(!tableExtract)
    endif
  enddo
  clock read all
endmethod

----------------------------------------------------------------------
-- Method:     createDataTable
--
-- Description: Set config details for the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
using namespace 'RamAEPMLExcelReader'
define method .extractTablesFromTransposeFormat(!excelReader is ANY, !tempNames is ARRAY, !className is STRING, !excelSheetName is STRING, $
                                                !nameColumn is STRING, !nameColumnIndex is REAL, !headingColumnIndex is REAL, !valueColumnIndex is REAL, !uomColumnIndex is REAL) is ARRAY

  !tempDataTables          = object ARRAY()
  do !tempName values !tempNames
    !tempNameTable         = !excelReader.getSheetRows(!excelSheetName, !nameColumnIndex, !tempName)
    !tempHeadings          = !tempNameTable.evaluate(object BLOCK(|!tempNameTable[!evalIndex][!headingColumnIndex].upcase()|))
    !sortedHeadingIndices  = !tempHeadings.SortedIndices()
    !tempNameTable.reIndex(!sortedHeadingIndices)
    !tempHeadings.reindex(!sortedHeadingIndices)
    !tempValues            = !tempNameTable.evaluate(object BLOCK(|!tempNameTable[!evalIndex][!valueColumnIndex]|))
    !tempUOMs              = !tempNameTable.evaluate(object BLOCK(|!tempNameTable[!evalIndex][!uomColumnIndex]|))
    !tempValueUom          = object ARRAY()
    do !i indices !tempValues
      if(!tempValues[!i].set() AND !tempValues[!i].trim().neq('')) then
        !tempValueUom.append(!tempValues[!i] + !tempUOMs[!i].trim())
      else
        !tempValueUom.append('')
      endif
    enddo

    -- Add name details to the row(in case not available for transpose format)
    !isAlreadyNameAvailable = !tempHeadings.FindFirst(!nameColumn.upcase()).set()
    if(!isAlreadyNameAvailable.not()) then
      !tempHeadings.Insert(1, !nameColumn)
      !tempValueUom.Insert(1, !tempName)
    endif

    !isTableIdentified     = false
    do !i indices !tempDataTables
      !storedHeadings      = !tempDataTables[!i][2]
      !difference1         = !tempHeadings.difference(!storedHeadings)
      !difference2         = !storedHeadings.difference(!tempHeadings)
      if(!difference1.unset() AND !difference2.unset()) then
        !tempDataTables[!i][3].append(!tempValueUom)
        !isTableIdentified = true
        break
      endif
    enddo
    if(!isTableIdentified.not()) then
      !tempTable           = object ARRAY()
      !tempTable.append(!tempValueUom)
      !data                = !this.createDataTable(!className, !tempHeadings, !tempTable, !excelSheetName)
      !tempDataTables.append(!data)
    endif
  enddo

  return !tempDataTables

endmethod

----------------------------------------------------------------------
-- Method:     createDataTable
--
-- Description: Set config details for the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .createDataTable(!className is STRING, !headings is ARRAY, !rowDetails is ARRAY, !excelSheetName is STRING) is ARRAY

  !data             = object ARRAY()
  !data.append(!className)
  !data.append(!headings)
  !data.append(!rowDetails)
  !data.append(!excelSheetName)
  !this.sheetCount  = !this.sheetCount + 1
  !data.append(!this.sheetCount.string())
  return !data

endmethod

----------------------------------------------------------------------
-- Method:     setConfigDetail
--
-- Description: Set config details for the object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
