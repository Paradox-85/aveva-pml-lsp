-- Benchmark: EBE_assetRegister_import.pmlmac
-- Purpose: Import asset register data from xlsx to AVEVA Engineering (PDMS/E3D)
-- Semantics: Excel -> NETGRIDCONTROL -> iterate rows -> CREATEELEMENT + ATTRIBUTE updates -> CSV issue log
-- Generated by pml-worker | blind benchmark generation (no original code copied)

!issueList = ARRAY()
!issueList.append(|Name;Issue description|)
!IssueFileName = |C:\AVEVA_SERVER\Reports\Logs\AssetRegister_MERGED_issues.csv|
!IssueFile = object FILE(!IssueFileName)
!IssueFile.Open('OVERWRITE')
!IssueFile.WriteRecord(|Tag No;Issue Description|)

import |Aveva.Engineering.PMLElementManager|
handle any
endhandle

import 'GridControl'
handle ANY
endhandle

using namespace |Aveva.Core.Presentation|
!dataTable = object NETGRIDCONTROL()
!fileName = 'C:\AVEVA_SERVER\Reports\AssetRegister_Upload.xlsx'
!dataSource = object NETDATASOURCE('Grid Table', !fileName)
!dataTable.bindToDataSource(!dataSource)
!data = !dataTable.getrows()
!heading = !dataTable.gettitles()

!nameId = !heading.findfirst(|NAME|)
!classId = !heading.findfirst(|ACTTYPE|)
!actionId = !heading.findfirst(|Upload_Action|)

if (!nameId.set()) then
  do !row values !data
    !tag = !row[!nameId].replace(|-|, |-|).trim()
    !class = !row[!classId].replace(|-|, |-|).trim()
    !tagName = |/$!<tag>|
    !tagref = !tagName.dbref()

    handle any
      using namespace |Aveva.Engineering.PMLElementManager|
      !elementNet = object CREATEELEMENT()
      !etype = object ELEMENTTYPE(|$!<class>|)

      if (!etype.valid() and !class.set() and !class neq || and !class.lowcase() neq |unset|) then
        !elementNet.SetElementTypeByName(|$!<class>|)
        !elementNet.AddAttributeValue(|NAME|, !tagName)
        !elementNet.Execute()
        !errors = !elementNet.GetErrors()
        do !error values !errors
          !msg = |$!tag;$!error|
          !IssueFile.WriteRecord(!msg)
        enddo
      else
        !msg = |$!tag;Class [$!class] is not valid in AVEVA. Tag will not be created|
        !IssueFile.WriteRecord(!msg)
      endif
    endhandle

    !tag = !row[!nameId].replace(|-|, |-|).trim()
    !tagName = |/$!<tag>|
    !tagref = !tagName.dbref()
    handle none
      !tagref.desc = |$!<tagref.desc>#to be deleted|
      if (!row[!actionId] eq |TRUE|) then
        do !col values !heading
          !col = !col.trim()
          if (!col neq |NAME| and !col neq |ACTTYPE| and !col neq |Upload_Action|) then
            !idx = !heading.findfirst(!col)
            !attribute = object ATTRIBUTE(|$!col|)
            if (!attribute.valid()) then
              !currentValue = !tagref.attribute(!attribute.name()).String()
              handle none
                !fileValue = !row[!idx]
                !tagref.attribute(!attribute.name()) = !fileValue
                handle any
                  !msg = |$!tag;$!!error.text|
                  !IssueFile.WriteRecord(!msg)
                endhandle
              elsehandle any
                !msg = |$!tag;$!!error.text|
                !IssueFile.WriteRecord(!msg)
              endhandle
            else
              !msg = |$!tag;Attribute [$!col] is not valid in AVEVA for this item. Attribute value will not be uploaded|
              !IssueFile.WriteRecord(!msg)
            endif
          endif
        enddo
      endif
    elsehandle any
      !msg = |$!tag;Tag is not existing in AVEVA|
      !IssueFile.WriteRecord(!msg)
    endhandle
  enddo
endif

!IssueFile.Close()
FINISH
