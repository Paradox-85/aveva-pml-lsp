$* loop-create.pmlmac
$* Reloads the LOOPDATA object and runs loop creation with logging.

handle any
  PML RELOAD OBJECT LOOPDATA
endhandle

!loop = object LOOPDATA()

handle any
  !loop.GetData()
endhandle

handle any
  !loop.LoopCreate()
endhandle

!loop.pathName = |C:\Temp\loop-create-log| 

handle any
  !loop.SaveLog(|loop-create-log.xlsx|, false)
endhandle

exit
