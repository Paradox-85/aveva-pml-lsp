handle any
endhandle


!headers = ARRAY()
!rows = ARRAY()
!headers.Append(|Source File|)
!headers.Append(|Pattern|)
!headers.Append(|Value|)

!patterns = ARRAY()
!patterns.Append(|handle|)
!patterns.Append(|RAMCOMMONLOGGER|)
!patterns.Append(|ATTRIBUTE|)
!patterns.Append(|matchwild|)
!patterns.Append(|!!|)
!patterns.Append(|ARRAY|)
!patterns.Append(|FILE|)

DO !i FROM 1 TO !patterns.Size()
  !row = ARRAY()
  !row.Append(|JDE_routine-macro-run.pmlmac|)
  !row.Append(!patterns[!i])
  !row.Append(!i.String())
  !rows.Append(!row)
ENDDO

handle any
  import 'GridControl'
endhandle
using namespace |Aveva.Core.Presentation|
!grid = object NETGRIDCONTROL()
!grid.clearGrid()
!source = object NETDATASOURCE('data', !headers, !rows)
!grid.BindToDataSource(!source)
!out = |C:\Temp\mac_30_benchmark.xlsx|
!grid.saveGridToExcel(!out, |data|)
